{
  "manifest_version": 3,
  "name": "ArcadeMatrix Music Sender",
  "version": "1.1",
  "description": "Sends now-playing information to ArcadeMatrix_RPI for display on LED matrix",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.deezer.com/*", "https://deezer.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ArcadeMatrix Music Sender"
  }
}
